# ============================================================
# Copie este arquivo para ".env.local" e preencha com seus valores.
# (No deploy da Vercel, você cola estes mesmos valores em Settings > Environment Variables.)
# ============================================================

# Do painel do Supabase: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Invente uma senha aleatória qualquer (ex.: 32 caracteres). Protege o cron de resultados.
CRON_SECRET=troque-isto-por-uma-senha-aleatoria-longa
